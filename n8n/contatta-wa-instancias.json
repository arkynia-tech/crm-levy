    {
      "id": "wa-11",
      "name": "uazapi criar",
      "notes": "Usa o admintoken da uazapi (credencial arkynia-uazapi). O nome da instância sai do rótulo digitado no CRM, para bater com o que aparece lá.\nFALTA CREDENCIAL: crie um Header Auth com nome 'admintoken' e o admintoken da uazapi, e anexe aqui.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "onError": "continueRegularOutput",
      "position": [
        1500,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://arkyniatech.uazapi.com/instance/create",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){\n  const ctx = $('Contexto').first().json;\n  // Nome legível no painel da uazapi, a partir do que a pessoa digitou.\n  // O sufixo com o começo do client_id existe porque lá o nome é único na\n  // conta inteira: duas lojas poderiam querer \"vendas\".\n  const slug = String(ctx.label || 'instancia')\n    .toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '')\n    .slice(0, 24) || 'instancia';\n  return JSON.stringify({ name: slug + '-' + String(ctx.client_id).slice(0, 8) });\n})() }}"
      }
    },
    {
      "id": "wa-12",
