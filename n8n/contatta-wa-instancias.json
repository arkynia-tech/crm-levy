        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_user_id: $json.user_id, p_client_id: $json.client_id }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "PInceeL9GkpLm81V",
          "name": "crm-levy"
