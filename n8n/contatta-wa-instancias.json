      "parameters": {
        "jsCode": "\n// Junta o que veio do CRM com quem é o usuário, para o resto do fluxo usar.\nconst body = $('Webhook Instancias WA').first().json.body || {};\nconst user = $('Validar token do CRM').first().json || {};\nreturn [{ json: {\n  user_id: user.id || null,\n  action: String(body.action || ''),\n  client_id: body.client_id || null,\n  instance_id: body.instance_id || null,\n  label: body.label || null\n} }];\n"
      }
