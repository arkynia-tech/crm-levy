      "parameters": {
        "method": "POST",
        "url": "https://lopdvdblwasuowjdokpo.supabase.co/rest/v1/wa_instances",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){\n  const ctx = $('Contexto').first().json;\n  const r = $('uazapi criar').first().json || {};\n  const inst = r.instance || r;\n  return JSON.stringify({\n    client_id: ctx.client_id,\n    instance_name: inst.name || inst.instance_name || inst.id,\n    label: ctx.label,\n    status: 'disconnected',\n    created_by: ctx.user_id\n  });\n})() }}"
      },
