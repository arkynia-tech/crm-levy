    {
      "id": "6b439ece-4b00-426c-b6ef-b26c488a4cc8",
      "name": "Gravar enriquecimento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "executeOnce": true,
      "position": [
        3136,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lopdvdblwasuowjdokpo.supabase.co/rest/v1/customers?on_conflict=id",
        "authentication": "predefinedCredentialType",
