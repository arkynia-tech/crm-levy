              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "body"
            }
          }
        }
      }
    },
    {
      "id": "d1cd245c-1473-4379-aaea-35d63be86daa",
      "name": "Montar patches",
      "notes": "Opera sobre o lote corrente ($('Loop em lotes').all()), nao sobre a lista inteira. E o que permite gravar de 25 em 25: quebrou no lote 21, os 20 anteriores ja estao no banco.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2688,
        320
      ],
      "parameters": {
        "jsCode": "\n// Trabalha sobre o lote corrente do loop, nao sobre a lista inteira: e isso\n// que permite gravar de 25 em 25 e nao perder tudo se quebrar no meio.\nconst atuais = $('Loop em lotes').all().map(function (i) { return i.json; });\nconst respostas = $input.all().map(function (i) { return i.json; });\nconst agora = new Date().toISOString();\n\nfunction titleCase(s){ return String(s||'').toLowerCase().replace(/(^|\\s)\\S/g, function(m){return m.toUpperCase();}); }\n\nfunction abrir(r) {\n  if (!r) return { status: null, dados: null };\n  const status = (r.statusCode != null) ? Number(r.statusCode) : null;\n  let b = (r.body !== undefined) ? r.body : r;\n  if (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = null; } }\n  if (b && typeof b === 'object' && b.d !== undefined) {\n    let d = b.d;\n    if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = null; } }\n    b = d;\n  }\n  if (Array.isArray(b)) b = b[0] || null;\n  if (b && typeof b === 'object' && Object.keys(b).length === 0) b = null;\n  return { status: status, dados: (b && typeof b === 'object') ? b : null };\n}\n\n// Ate 4 celulares. Prefere o marcado como WhatsApp; nao havendo, o primeiro.\nfunction telefone(t) {\n  if (!t) return null;\n  for (let passo = 0; passo < 2; passo++) {\n    for (let i = 1; i <= 4; i++) {\n      const ddd = t['DDDCEL' + i], cel = t['CEL' + i], wa = t['FLWHATSAPPCEL' + i];\n      if (!ddd || !cel) continue;\n      if (passo === 0 && wa !== 'S') continue;\n      return String(ddd) + String(cel);\n    }\n  }\n  return null;\n}\n\n// a 2429 manda AAAAMMDD; o NVCHECK mandava DD/MM/AAAA\nfunction nascimento(s) {\n  const v = String(s || '').trim();\n  if (/^\\d{8}$/.test(v)) return v.slice(0,4) + '-' + v.slice(4,6) + '-' + v.slice(6,8);\n  if (/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(v)) { const p = v.split('/'); return p[2]+'-'+p[1]+'-'+p[0]; }\n  return null;\n}\n\nconst rows = [];\nlet comTelefone = 0, semDado = 0, falhas = 0;\nconst motivos = {};\n\nfor (let i = 0; i < atuais.length; i++) {\n  const c = atuais[i];\n  if (!c || !c.id) continue;\n\n  const r = abrir(respostas[i]);\n  const st = r.status;\n\n  // Resposta que nao e 200 nem 204 significa pergunta NAO respondida: nao\n  // marcar enriched_at. Marcar foi o que tirou 2.896 CPFs da fila em agosto,\n  // quando o saldo acabou e ninguem viu.\n  if (st !== null && st !== 200 && st !== 204) {\n    falhas++;\n    // a razao vem em texto puro (ex.: 'SALDO PRE PAGO INSUFICIENTE!'). O doc\n    // promete 403 para saldo, a API devolve 400 - por isso agrupa pela\n    // mensagem, nao pelo codigo.\n    let razao = '';\n    const cru = (respostas[i] || {}).body;\n    if (typeof cru === 'string') razao = cru.trim().slice(0, 120);\n    else if (cru && typeof cru === 'object') razao = String(cru.d || cru.message || '').slice(0, 120);\n    const chave = razao || ('HTTP ' + st);\n    motivos[chave] = (motivos[chave] || 0) + 1;\n    continue;\n  }\n\n  const d = r.dados;\n  const extra = Object.assign({}, c.extra || {});\n  extra.enriched_at = agora;\n  extra.novavida = { fonte: 'nvbook_pf_2429', http: st, resposta: d };\n\n  // Todas as linhas com AS MESMAS CHAVES: o insert em lote do PostgREST recusa\n  // o array se um objeto tiver uma chave a menos. O valor atual entra como\n  // padrao, entao campo sem dado novo e regravado igual, nunca anulado.\n  const row = {\n    id: c.id, extra: extra,\n    phone: c.phone || null, email: c.email || null,\n    birth_date: c.birth_date || null, city: c.city || null, state: c.state || null,\n  };\n\n  if (d) {\n    if (!c.phone) {\n      const bruto = telefone(d.TELEFONES);\n      if (bruto) { row.phone = '+55' + bruto; comTelefone++; }\n    }\n    if (!c.email) { const em = d.EMAILS || {}; if (em.EMAIL1) row.email = em.EMAIL1; }\n    if (!c.birth_date) { const n = nascimento((d.IDENTIFICACAO || {}).NASC); if (n) row.birth_date = n; }\n    const end = d.ENDERECO || {};\n    if (!c.city && end.CIDADE) row.city = titleCase(end.CIDADE);\n    if (!c.state && end.UF) row.state = end.UF;\n  } else {\n    semDado++;\n  }\n  rows.push(row);\n}\n\nreturn [{ json: {\n  total: rows.length, com_telefone: comTelefone, sem_dado: semDado,\n  falhas: falhas, motivos: motivos, rows: rows\n} }];\n"
      }
    },
