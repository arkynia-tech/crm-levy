      "name": "Consultar NovaVida",
      "notes": "NVBOOK_PF 2429: form-urlencoded, token no CORPO. responseFormat=text porque os erros vem em plain/text - pedindo JSON o n8n descarta o corpo e o motivo se perde.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "alwaysOutputData": true,
      "position": [
        2464,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wsnv.novavidati.com.br/WSLocalizador.asmx/CONSULTAR",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "consulta",
              "value": "2429"
            },
            {
              "name": "documento",
              "value": "={{ String($json.cpf || '').replace(/[^0-9]/g, '') }}"
            },
            {
              "name": "token",
              "value": "={{ $('Gerar Token').first().json.body.d }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
