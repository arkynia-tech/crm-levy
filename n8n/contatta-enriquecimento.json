      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "executeOnce": true,
      "position": [
        2912,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lopdvdblwasuowjdokpo.supabase.co/rest/v1/customers?on_conflict=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){\n  const b = $('Enriquecer').first().json.body || {};\n  const cid = b.client_id || '677c58eb-b3ec-493a-ad14-0d052d7d8a45';\n  const rows = $('Montar patches').first().json.rows || [];\n  // client_id vai junto porque o upsert do PostgREST monta um INSERT: sem ele\n  // a coluna NOT NULL derruba a chamada antes de chegar no ON CONFLICT.\n  return JSON.stringify(rows.map(function(r){ return Object.assign({ client_id: cid }, r); }));\n})() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
