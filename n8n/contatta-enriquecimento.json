    {
      "id": "8c066901-6189-4a70-b069-8bb095f7bb51",
      "name": "Consultar NovaVida",
      "notes": "NVBOOK_PF, consulta 2429: form-urlencoded, token no CORPO (nao no header). fullResponse + neverError para distinguir 204 'nada consta' de 403 saldo e 429 limite - sem isso os tres deixam o mesmo rastro, que foi o que travou 2.896 CPFs.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "alwaysOutputData": true,
      "position": [
        2240,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wsnv.novavidati.com.br/WSLocalizador.asmx/CONSULTAR",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "consulta",
              "value": "2429"
            },
            {
              "name": "documento",
              "value": "={{ String($json.cpf || '').replace(/[^0-9]/g, '') }}"
            },
            {
              "name": "token",
              "value": "={{ $('Gerar Token').first().json.d }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "d1cd245c-1473-4379-aaea-35d63be86daa",
      "name": "Montar patches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        320
      ],
      "parameters": {
        "jsCode": "\n// Cada item de entrada e a resposta da 2429 para o cliente de mesmo indice em\n// \"Buscar dados atuais\" - a ordem e preservada item a item.\nconst atuais = $('Buscar dados atuais').all().map(function (i) { return i.json; });\nconst respostas = $input.all().map(function (i) { return i.json; });\nconst agora = new Date().toISOString();\n\nfunction titleCase(s){ return String(s||'').toLowerCase().replace(/(^|\\s)\\S/g, function(m){return m.toUpperCase();}); }\n\n// fullResponse esta ligado: cada item vem {body, statusCode, headers}. E o que\n// permite distinguir \"a NovaVida respondeu que nao tem\" de \"a chamada falhou\" -\n// distincao que nao existia antes e travou 2.896 CPFs.\nfunction abrir(r) {\n  if (!r) return { status: null, dados: null };\n  const status = (r.statusCode != null) ? Number(r.statusCode) : null;\n  let b = (r.body !== undefined) ? r.body : r;\n  if (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = null; } }\n  // o doc mostra o objeto na raiz, mas na pratica vem [{...}]; e o NVCHECK\n  // antigo embrulhava em \"d\". Aceita os tres.\n  if (b && typeof b === 'object' && b.d !== undefined) {\n    let d = b.d;\n    if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = null; } }\n    b = d;\n  }\n  if (Array.isArray(b)) b = b[0] || null;\n  if (b && typeof b === 'object' && Object.keys(b).length === 0) b = null;\n  return { status: status, dados: (b && typeof b === 'object') ? b : null };\n}\n\n// Ate 4 celulares. Prefere o marcado como WhatsApp; nao havendo, o primeiro.\nfunction telefone(t) {\n  if (!t) return null;\n  for (let passo = 0; passo < 2; passo++) {\n    for (let i = 1; i <= 4; i++) {\n      const ddd = t['DDDCEL' + i], cel = t['CEL' + i], wa = t['FLWHATSAPPCEL' + i];\n      if (!ddd || !cel) continue;\n      if (passo === 0 && wa !== 'S') continue;   // primeira passada: so WhatsApp\n      return String(ddd) + String(cel);\n    }\n  }\n  return null;\n}\n\n// a 2429 manda AAAAMMDD; o NVCHECK mandava DD/MM/AAAA\nfunction nascimento(s) {\n  const v = String(s || '').trim();\n  if (/^\\d{8}$/.test(v)) return v.slice(0,4) + '-' + v.slice(4,6) + '-' + v.slice(6,8);\n  if (/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(v)) { const p = v.split('/'); return p[2]+'-'+p[1]+'-'+p[0]; }\n  return null;\n}\n\nconst vistos = new Set();\nconst rows = [];\nlet comTelefone = 0, semDado = 0, falhas = 0;\nconst motivos = {};\n\nfor (let i = 0; i < atuais.length; i++) {\n  const c = atuais[i];\n  if (!c || !c.id || vistos.has(c.id)) continue;\n  vistos.add(c.id);\n\n  const r = abrir(respostas[i]);\n  const st = r.status;\n\n  // 403 saldo/permissao, 429 limite, 5xx erro deles: a pergunta NAO foi\n  // respondida. Nao marcar enriched_at - marcar foi exatamente o que tirou\n  // 2.896 CPFs da fila sem ninguem ter perguntado por eles.\n  if (st !== null && st !== 200 && st !== 204) {\n    falhas++;\n    motivos['HTTP ' + st] = (motivos['HTTP ' + st] || 0) + 1;\n    continue;\n  }\n\n  const d = r.dados;\n  const patch = { id: c.id };\n  const extra = Object.assign({}, c.extra || {});\n  // enriched_at so entra aqui: 200 com dado, ou 204 \"nada consta\". Nos dois\n  // casos a NovaVida respondeu.\n  extra.enriched_at = agora;\n  extra.novavida = { fonte: 'nvbook_pf_2429', http: st, resposta: d };\n  patch.extra = extra;\n\n  if (d) {\n    if (!c.phone) {\n      const bruto = telefone(d.TELEFONES);\n      if (bruto) { patch.phone = '+55' + bruto; comTelefone++; }\n    }\n    if (!c.email) {\n      const em = d.EMAILS || {};\n      if (em.EMAIL1) patch.email = em.EMAIL1;\n    }\n    if (!c.birth_date) {\n      const nasc = nascimento((d.IDENTIFICACAO || {}).NASC);\n      if (nasc) patch.birth_date = nasc;\n    }\n    const end = d.ENDERECO || {};\n    if (!c.city && end.CIDADE) patch.city = titleCase(end.CIDADE);\n    if (!c.state && end.UF) patch.state = end.UF;\n  } else {\n    semDado++;\n  }\n\n  rows.push(patch);\n}\n\nreturn [{ json: {\n  total: rows.length, com_telefone: comTelefone, sem_dado: semDado,\n  falhas: falhas, motivos: motivos, rows: rows\n} }];\n"
      }
    },
