    {
      "name": "Consultar NovaVida",
      "notes": "Roda uma vez por item de entrada. onError continua para um CPF ruim nao derrubar a rodada inteira.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        2240,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wsnv.novavidati.com.br/wslocalizador.asmx/NVCHECKJson",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Token",
              "value": "={{ $('Gerar Token').first().json.d }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ nvcheck: { Documento: String($json.cpf || '').replace(/[^0-9]/g, '') } }) }}",
        "options": {}
      },
      "id": "8c066901-6189-4a70-b069-8bb095f7bb51"
    },
    {
      "name": "Montar patches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        320
      ],
      "parameters": {
        "jsCode": "\n// Cada item de entrada e a resposta da NovaVida para o cliente de mesmo indice\n// em \"Buscar dados atuais\" - a ordem e preservada item a item.\nconst atuais = $('Buscar dados atuais').all().map(function (i) { return i.json; });\nconst respostas = $input.all().map(function (i) { return i.json; });\nconst agora = new Date().toISOString();\n\nfunction titleCase(s){ return String(s||'').toLowerCase().replace(/(^|\\s)\\S/g, function(m){return m.toUpperCase();}); }\n\n// o servico e ASMX: as vezes devolve o objeto em .d, as vezes .d e uma string\nfunction consulta(j) {\n  if (!j) return null;\n  let d = (j.d !== undefined) ? j.d : j;\n  if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { return null; } }\n  if (!d || typeof d !== 'object') return null;\n  return d.CONSULTA || d.consulta || (d.NVCHECK || {}).CONSULTA || null;\n}\n\nconst vistos = new Set();\nconst rows = [];\nlet comTelefone = 0;\n\nfor (let i = 0; i < atuais.length; i++) {\n  const c = atuais[i];\n  if (!c || !c.id || vistos.has(c.id)) continue;\n  const con = consulta(respostas[i]);\n\n  const patch = { id: c.id };\n  // enriched_at marca CONSULTA FEITA, mesmo quando volta vazia. E o que\n  // impede a fila de reoferecer o mesmo CPF amanha - ver crm_enrich_pendentes.\n  const extra = Object.assign({}, c.extra || {});\n  extra.enriched_at = agora;\n  if (con) extra.novavida = { CONSULTA: con };\n  patch.extra = extra;\n\n  if (con) {\n    if (!c.phone) {\n      const tels = Array.isArray(con.TELEFONES) ? con.TELEFONES : [];\n      const t = tels.find(function (x) { return x && x.FLWHATS === 'S'; }) || tels[0];\n      if (t && t.TELEFONE) { patch.phone = '+55' + String(t.DDD || '') + String(t.TELEFONE || ''); comTelefone++; }\n    }\n    if (!c.email) {\n      const em = Array.isArray(con.EMAILS) ? con.EMAILS : [];\n      if (em[0] && em[0].EMAIL) patch.email = em[0].EMAIL;\n    }\n    if (!c.birth_date) {\n      const nasc = (con.CADASTRAIS || {}).NASC;\n      if (nasc && /^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(nasc)) {\n        const p = nasc.split('/'); patch.birth_date = p[2] + '-' + p[1] + '-' + p[0];\n      }\n    }\n    const end = Array.isArray(con.ENDERECOS) ? con.ENDERECOS : [];\n    if (!c.city && end[0] && end[0].CIDADE) patch.city = titleCase(end[0].CIDADE);\n    if (!c.state && end[0] && end[0].UF) patch.state = end[0].UF;\n  }\n\n  vistos.add(c.id);\n  rows.push(patch);\n}\n\nreturn [{ json: { total: rows.length, com_telefone: comTelefone, rows: rows } }];\n"
      },
      "id": "d1cd245c-1473-4379-aaea-35d63be86daa"
    },
