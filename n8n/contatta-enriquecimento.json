    {
      "id": "92d58246-500e-4090-a67f-43ce89dedf05",
      "name": "Continuar?",
      "notes": "Qualquer recusa da NovaVida (saldo, limite) para o loop na hora, em vez de disparar os lotes restantes para tomar o mesmo erro.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        3360,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $('Montar patches').first().json.falhas === 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "id": "705ab02e-d951-43b7-83b2-ee5e8757ec75"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b81a5c46-c5d9-4873-a45f-4d6fd7ddda7c",
      "name": "Somar resultado",
      "notes": "Soma TODAS as rodadas do loop. Sem isso o total mostraria so o ultimo lote.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        320
      ],
      "parameters": {
        "jsCode": "\nconst tot = { gravados: 0, enriquecidos: 0, sem_dado: 0, falhas: 0, lotes: 0 };\nconst motivos = {};\nfor (let k = 0; ; k++) {\n  let itens;\n  try { itens = $('Montar patches').all(0, k); } catch (e) { break; }\n  if (!itens || !itens.length) break;\n  const j = itens[0].json || {};\n  tot.lotes += 1;\n  tot.gravados += j.total || 0;\n  tot.enriquecidos += j.com_telefone || 0;\n  tot.sem_dado += j.sem_dado || 0;\n  tot.falhas += j.falhas || 0;\n  for (const m of Object.keys(j.motivos || {})) motivos[m] = (motivos[m] || 0) + j.motivos[m];\n}\ntot.motivos = motivos;\n// quantos foram pedidos, para a tela mostrar se parou no meio\ntry { tot.pedidos = $('Buscar dados atuais').all().length; } catch (e) { tot.pedidos = null; }\ntot.parcial = (tot.pedidos != null) && (tot.gravados + tot.falhas < tot.pedidos);\nreturn [{ json: tot }];\n"
      }
    },
