        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){\n  const b = $('Enriquecer').first().json.body || {};\n  const cid = b.client_id;\n  const rows = $('Montar patches').first().json.rows || [];\n  // client_id vai junto porque o upsert do PostgREST monta um INSERT: sem ele\n  // a coluna NOT NULL derruba a chamada antes de chegar no ON CONFLICT.\n  return JSON.stringify(rows.map(function(r){ return Object.assign({ client_id: cid }, r); }));\n})() }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "PRN6da97tPlcboNV",
          "name": "Supabase CRM-Contatta"
        }
      }
    },
    {
