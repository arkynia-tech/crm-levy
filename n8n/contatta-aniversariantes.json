    {
      "id": "2247c855-888e-4eea-acc8-e8e5e0cf7e2c",
      "name": "Aniversariantes de hoje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "jsCode": "\n// O banco ja entregou quem e alcancavel e quem faz aniversario hoje. Aqui so\n// entra a mensagem configurada e o descarte de quem pediu para sair.\nconst cfg = ($('Ler config').first() || {}).json || {};\nconst msg = ((cfg.value || {}).message) || 'Feliz aniversario!';\nconst pessoas = $('Buscar aniversariantes').all().map(function (i) { return i.json; });\nconst out = [];\nfor (const p of pessoas) {\n  if (!p || !p.wa_number || p.optout) continue;\n  out.push({ json: { customer_id: p.customer_id, name: p.nome || null, wa_number: p.wa_number, message: msg } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "4bea6964-8bbe-432e-b987-be1ea2f03f5f",
