      "name": "Enviar uazapi",
      "notes": "Token da uazapi e da INSTANCIA e muda a cada recriacao. Vem de crm_wa_envio_of.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "onError": "continueRegularOutput",
      "position": [
        1568,
        192
      ],
      "parameters": {
        "method": "POST",
        "url": "https://arkyniatech.uazapi.com/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $('Buscar instância conectada').first().json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.wa_number.replace('+',''), text: $json.message }) }}",
        "options": {}
      }
    },
