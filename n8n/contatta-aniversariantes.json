    {
      "id": "2247c855-888e-4eea-acc8-e8e5e0cf7e2c",
      "name": "Aniversariantes de hoje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "jsCode": "\nconst clientes = $('Buscar clientes').all().map(function(i){ return i.json; });\nconst optArr = $('Buscar optouts').all().map(function(i){ return (i.json && i.json.wa_number) || ''; });\nconst optSet = new Set(optArr.filter(Boolean));\nconst cfg = ($('Ler config').first() || {}).json || {};\nconst msg = ((cfg.value || {}).message) || 'Feliz aniversario!';\nconst now = new Date();\nconst mm = ('0' + (now.getMonth() + 1)).slice(-2);\nconst dd = ('0' + now.getDate()).slice(-2);\nfunction digits(s){ return String(s == null ? '' : s).split('').filter(function(c){ return c >= '0' && c <= '9'; }).join(''); }\nfunction norm(p){ let d = digits(p); if (d.length < 10) return null; if (d.indexOf('55') !== 0) { if (d.length > 11) return null; d = '55' + d; } if (d.length < 12 || d.length > 13) return null; return '+' + d; }\nconst seen = new Set();\nconst out = [];\nfor (const c of clientes) {\n  const bd = String(c.birth_date || '');\n  if (bd.slice(5, 7) !== mm || bd.slice(8, 10) !== dd) continue;\n  const wa = norm(c.phone);\n  if (!wa || seen.has(wa) || optSet.has(wa)) continue;\n  seen.add(wa);\n  out.push({ json: { customer_id: c.id, name: c.name || null, wa_number: wa, message: msg } });\n}\nreturn out;\n"
      }
    },
