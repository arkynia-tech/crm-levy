    {
      "id": "17d8aea5-4504-4a8d-888c-994f6676b3f1",
      "name": "Buscar publico",
      "notes": "A regra de quem e alcancavel mora no banco (crm_wa_publico_of): numero valido, do cadastro ou do pedido mais recente, sem repeticao, com o opt-out marcado. Sem limite de linhas - o limit=2000 antigo escondia 2831 clientes.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "alwaysOutputData": true,
      "position": [
        672,
        624
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lopdvdblwasuowjdokpo.supabase.co/rest/v1/rpc/crm_wa_publico_of",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){\n  const b = $('WA Campanha').first().json.body || {};\n  const a = b.audience || {};\n  let uid = null;\n  try { uid = ($('Validar login do CRM').first().json || {}).id || null; } catch (e) {}\n  // manual e test nao consultam por tipo: o manual filtra a lista completa\n  // depois, e o test usa numeros digitados. 'filtros' e o publico\n  // personalizado (publicos-personalizados.sql): so ele leva p_filtros, entao\n  // os outros tipos continuam batendo na funcao antiga.\n  const tipo = (a.type === 'recent' || a.type === 'segment' || a.type === 'filtros') ? a.type : 'all';\n  const corpo = {\n    p_user_id: uid,\n    p_client_id: b.client_id,\n    p_tipo: tipo,\n    p_segment: a.segment || null,\n    p_days: Number(a.days) || 90,\n    p_min_spent: Number(a.min_spent) || 300\n  };\n  if (tipo === 'filtros') corpo.p_filtros = a.filtros || {};\n  return JSON.stringify(corpo);\n})() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "PRN6da97tPlcboNV",
          "name": "Supabase CRM-Contatta"
        }
      }
    },
    {
      "id": "019ae002-2e82-466d-97ba-7707c758f75c",
      "name": "Montar publico",
      "notes": "Sem executeOnce de proposito: com ele ligado, $input/$() enxergam so o primeiro item e a campanha sai com 1 contato.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        624
      ],
      "parameters": {
        "jsCode": "\nconst req = $('WA Campanha').first().json.body || {};\nconst aud = req.audience || {};\n\nfunction digits(s){ return String(s == null ? '' : s).replace(/[^0-9]/g, ''); }\n// so para os numeros de teste digitados na tela; o resto ja vem normalizado\n// do banco, por crm_wa_publico_of\nfunction norm(p) {\n  if (!p) return null;\n  let d = digits(p);\n  if (d.length < 10) return null;\n  if (d.indexOf('55') !== 0) { if (d.length > 11) return null; d = '55' + d; }\n  if (d.length < 12 || d.length > 13) return null;\n  return '+' + d;\n}\n\n// le o no pelo nome de proposito: $input.all() obedece ao executeOnce e ja\n// nos entregou 1 contato de 905\nfunction publicoDoBanco() {\n  try { return $('Buscar publico').all().map(function (i) { return i.json; }); }\n  catch (e) { return []; }\n}\n\nlet contatos = [];\nlet pulados = 0;\n\nif (aud.type === 'test') {\n  contatos = (aud.numbers || [])\n    .map(function (n) { return { wa_number: norm(n), name: 'Numero de teste', customer_id: null }; })\n    .filter(function (c) { return c.wa_number; });\n} else {\n  const manual = new Set((aud.customer_ids || []).map(String));\n  const publico = publicoDoBanco().filter(function (j) { return j && j.wa_number; });\n  for (const p of publico) {\n    if (aud.type === 'manual' && !manual.has(String(p.customer_id))) continue;\n    if (p.optout) { pulados++; continue; }\n    contatos.push({ wa_number: p.wa_number, name: p.nome || null, customer_id: p.customer_id });\n  }\n}\n\nconst vistos = new Set();\nconst finais = [];\nfor (const c of contatos) {\n  if (!c.wa_number || vistos.has(c.wa_number)) continue;\n  vistos.add(c.wa_number);\n  finais.push(c);\n}\n\nreturn [{ json: {\n  action: req.action, name: req.name || null, message_body: req.message_body || null,\n  audience: aud, total: finais.length, skipped_optout: pulados,\n  sample: finais.slice(0, 10), recipients: finais\n} }];\n"
      }
    },
