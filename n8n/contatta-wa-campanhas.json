    {
      "name": "Montar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        160
      ],
      "parameters": {
        "jsCode": "\nconst camp = $('Buscar campanha').first().json;\nconst rec = $('Loop de envio').first().json;\nconst num = String(rec.wa_number || '').replace('+','');\nconst UAZ = 'https://arkyniatech.uazapi.com';\n// limpa o link do Shopee para a forma curta/canonica (sem rastreamento)\nlet text = (camp.message_body || '').replace(/https?:\\/\\/\\S*?shopee\\S*?i\\.(\\d+)\\.(\\d+)\\S*/gi, 'https://shopee.com.br/product/$1/$2');\nlet endpoint, payload;\nif (camp.media_url) {\n  endpoint = UAZ + '/send/media';\n  payload = { number: num, type: 'image', file: camp.media_url, text: text };\n} else {\n  endpoint = UAZ + '/send/text';\n  payload = { number: num, text: text, linkPreview: true };\n}\nreturn [{ json: { endpoint: endpoint, payload: payload } }];\n"
      },
      "id": "945168f8-9dc2-4d89-8976-3f06addca7fb"
    },
