    {
      "id": "945168f8-9dc2-4d89-8976-3f06addca7fb",
      "name": "Montar envio",
      "notes": "Variacoes {a|b|c} e {{nome}} resolvidas POR DESTINATARIO: texto identico para centenas de numeros e o padrao que o WhatsApp usa para flagrar disparo em massa. O `delay` no corpo faz a uazapi digitar antes de enviar.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        160
      ],
      "parameters": {
        "jsCode": "\n// {a|b|c} vira uma das opcoes, sorteada por destinatario. Aninhado funciona:\n// {Oi|Olá}{, tudo bem?|!} da 4 combinacoes.\nfunction variar(txt) {\n  let s = String(txt || '');\n  for (let voltas = 0; voltas < 10; voltas++) {\n    const antes = s;\n    s = s.replace(/\\{([^{}]*\\|[^{}]*)\\}/g, function (_, dentro) {\n      const ops = dentro.split('|');\n      return ops[Math.floor(Math.random() * ops.length)];\n    });\n    if (s === antes) break;\n  }\n  return s;\n}\n\nfunction primeiroNome(nome) {\n  const primeiro = String(nome || '').trim().split(/\\s+/)[0] || '';\n  return primeiro ? primeiro.charAt(0).toUpperCase() + primeiro.slice(1).toLowerCase() : '';\n}\n\n// {{nome}} vira o primeiro nome. Sem nome, some junto com o espaco que sobra.\nfunction personalizar(txt, nome) {\n  const bonito = primeiroNome(nome);\n  return String(txt || '')\n    .replace(/\\s*\\{\\{\\s*nome\\s*\\}\\}/gi, bonito ? ' ' + bonito : '')\n    .replace(/  +/g, ' ')\n    .trim();\n}\n\n// Tempo \"digitando\" antes de mandar, em ms (o Mensy mostra digitando ate 15 s).\n// E diferente da pausa ENTRE destinatarios - esta acontece dentro da mesma\n// conversa, e e o que faz a mensagem chegar como gente e nao como robo.\nfunction tempoDigitando(txt) {\n  const n = String(txt || '').length;\n  return Math.min(15000, Math.max(1500, Math.round(n * 55 + Math.random() * 1200)));\n}\n\nconst camp = $('Buscar campanha').first().json;\nconst rec = $('Loop de envio').first().json;\nconst num = String(rec.wa_number || '').replace('+','');\n\n// ---------------- API oficial (Meta): modelo aprovado ----------------\n// Campanha com template_id sai pela Cloud API. Variaveis vem de\n// template_params: { var: { fonte: 'nome'|'texto', valor, padrao } }.\n// A Meta recusa variavel vazia, por isso sempre sai algum texto.\nif (camp.template_id) {\n  const inst = $('Buscar instancia conectada').first().json;\n  const ps = camp.template_params || {};\n  const posicional = String(camp.template_format || 'NAMED').toUpperCase() === 'POSITIONAL';\n  const nome = primeiroNome(rec.display_name);\n  function valor(k) {\n    const p = ps[k] || {};\n    const v = p.fonte === 'nome' ? (nome || p.padrao || 'cliente') : (p.valor || '');\n    return String(v).trim() || '-';\n  }\n  let chaves = Object.keys(ps);\n  if (posicional) chaves = chaves.sort(function (a, b) { return Number(a) - Number(b); });\n  const components = [];\n  if (String(camp.template_header || '').toUpperCase() === 'IMAGE' && camp.media_url) {\n    components.push({ type: 'header', parameters: [{ type: 'image', image: { link: camp.media_url } }] });\n  }\n  if (chaves.length) {\n    components.push({ type: 'body', parameters: chaves.map(function (k) {\n      return posicional ? { type: 'text', text: valor(k) } : { type: 'text', parameter_name: k, text: valor(k) };\n    }) });\n  }\n  return [{ json: {\n    provider: 'cloud_api',\n    endpoint: 'https://graph.facebook.com/v25.0/' + inst.phone_number_id + '/messages',\n    payload: {\n      messaging_product: 'whatsapp',\n      recipient_type: 'individual',\n      to: num,\n      type: 'template',\n      template: { name: camp.template_name, language: { code: camp.template_language || 'pt_BR' }, components: components }\n    },\n    texto: camp.message_body\n  } }];\n}\n\n// ---------------- número não oficial (Mensy; uazapi no número antigo) ----------------\n// Desde 25/10/2026 o envio sai pela função wa-envio do Contatta, que escolhe o\n// caminho pelo provider do número e guarda a chave do Mensy. Aqui só o texto.\n\n// limpa o link do Shopee para a forma curta/canonica (sem rastreamento)\nlet text = (camp.message_body || '').replace(/https?:\\/\\/\\S*?shopee\\S*?i\\.(\\d+)\\.(\\d+)\\S*/gi, 'https://shopee.com.br/product/$1/$2');\ntext = personalizar(variar(text), rec.display_name);\n\nconst inst = $('Buscar instancia conectada').first().json;\nreturn [{ json: {\n  provider: 'nao_oficial',\n  payload: {\n    instance_id: inst.instance_id,\n    to: num,\n    text: text,\n    media_url: camp.media_url || null,\n    delay_ms: tempoDigitando(text)\n  },\n  texto: text\n} }];\n"
      }
    },
