      "id": "dc6bb0ba-2c12-4bd1-8afd-d3e2594d47d8"
    },
    {
      "name": "Login criado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e375b312-8de5-4f4c-aa5a-2301770e16b2"
    },
    {
      "name": "Responder erro ao criar",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1344,
        480
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: (($json.msg || $json.message || ($json.error||{}).message) || 'Nao foi possivel criar o login. O e-mail ja pode estar em uso.') }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "39db3c10-ac0a-4b63-a879-fc5f506336b3"
    },
    {
      "name": "Dar acesso a loja",
      "notes": "Grava direto: crm_grant_access usa auth.uid(), que e NULO para o service_role. Quem checa permissao aqui e o no 'Pode conceder?'.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lopdvdblwasuowjdokpo.supabase.co/rest/v1/user_clients?on_conflict=user_id,client_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.id, client_id: ($('Acessos').first().json.body.client_id || '677c58eb-b3ec-493a-ad14-0d052d7d8a45'), role: ($('Acessos').first().json.body.role === 'collaborator' ? 'collaborator' : 'admin') }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "PRN6da97tPlcboNV",
          "name": "Supabase CRM-Contatta"
        }
      },
      "id": "25e779be-2cbc-4556-b282-d979f3727302"
    },
