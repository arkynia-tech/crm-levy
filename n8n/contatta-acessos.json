      "id": "ffb2548b-ce71-48f3-bd91-391355701de2"
    },
    {
      "name": "Criar login",
      "notes": "Usa a credencial do Supabase, que ja manda a service key no Authorization - e o que o endpoint de admin exige.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        896,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lopdvdblwasuowjdokpo.supabase.co/auth/v1/admin/users",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $('Acessos').first().json.body.email, password: $('Acessos').first().json.body.password, email_confirm: true }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "PRN6da97tPlcboNV",
          "name": "Supabase CRM-Contatta"
        }
