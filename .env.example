# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" do Supabase (NUNCA usar a service_role aqui)
VITE_SUPABASE_ANON_KEY=

# Webhook do n8n que processa upload de NF-e (ZIP ou XML)
VITE_N8N_NFE_WEBHOOK_URL=

# Webhook do n8n de campanhas de WhatsApp (prévia/criação/disparo)
VITE_N8N_WA_CAMPAIGN_URL=

# Webhook do n8n de enriquecimento de clientes (NovaVida)
VITE_N8N_ENRICH_URL=

# Webhook do n8n de admin de usuários (criar/listar/remover acesso) — só admin
VITE_N8N_ADMIN_USERS_URL=

# Webhook do n8n que gerencia as instâncias de WhatsApp na uazapi
# (criar, conectar/QR, status, desconectar, deletar) — admin e master
VITE_N8N_WA_INSTANCE_URL=
# Gera variações {a|b|c} da mensagem de campanha via OpenAI (roda no n8n)
VITE_N8N_VARIAR_URL=
